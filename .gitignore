# .NET 构建产物
bin/
obj/

# 发布产物（联调/部署包不入库，按需单独分发）
publish/
*.tgz

# 运行数据
*.db
*.db-shm
*.db-wal
*.log

# 现场配置备份（含现场 IP 等环境信息，不入库）
wsl-field-config-backup.json

# IDE
.vs/
.idea/
*.user

# 测试结果
TestResults/

# 离线开发包（安装器+VS layout+NuGet 缓存，约 10GB，不入库）
offline-kit/

# Office 锁文件（Word/Excel 打开期间的 ~$ 临时文件）
~$*
